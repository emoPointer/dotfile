[global_config]
  handle_size = 1
  window_state = maximise
  borderless = True
  title_transmit_fg_color = "#dc8add"
  title_transmit_bg_color = "#000000"
  title_receive_bg_color = "#2ec27e"
  title_inactive_fg_color = "#2ec27e"
  always_split_with_profile = True
[keybindings]
  split_horiz = <Primary><Shift>e
  split_vert = <Primary><Shift>o
[profiles]
  [[default]]
    background_color = "#1b1d21"
    background_darkness = 0.9
    background_type = transparent
    cursor_color = "#d7dae0"
    cursor_color_fg = False
    font = Monospace 12
    foreground_color = "#c9cdd4"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 50000
    palette = "#2e3436:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#729fcf:#06989a:#34e2e2:#eeeeec"
    use_system_font = False
    bold_is_bright = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
